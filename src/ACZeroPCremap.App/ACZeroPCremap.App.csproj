<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ACZeroPCremap</AssemblyName>
    <RootNamespace>ACZeroPCremap.App</RootNamespace>
    <Version>0.8.1</Version>
    <Product>ACZeroPCremap</Product>
    <Description>Keyboard and mouse binding editor for dinput.ini</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ACZeroPCremap.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ACZeroPCremap.ico" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\ACZeroPCremap.Core\ACZeroPCremap.Core.csproj" />
  </ItemGroup>
</Project>
