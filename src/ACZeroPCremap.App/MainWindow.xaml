<Window x:Class="ACZeroPCremap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ACZeroPCremap.App.Localization"
        Style="{StaticResource AppWindowStyle}"
        Title="{Binding WindowTitle}" Width="1100" Height="820" MinWidth="760" MinHeight="440"
        Tag="MainWindow" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="ActionRowTemplate">
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource QuietFrameBrush}" BorderThickness="0,0,0,1" Padding="0,0,10,0" Margin="0,0,0,3" MinHeight="56">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border x:Name="ActionNamePanel" BorderBrush="{StaticResource QuietFrameBrush}" BorderThickness="0,0,1,0" Padding="12,9" Margin="0,0,12,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ActionName" Text="{Binding Name}" ToolTip="{Binding Description}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="ActionCode" Text="{Binding Key}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextSecondary}" FontSize="11">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding EmptyText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,6,2">
                                        <Border Background="{StaticResource FieldBackground}" CornerRadius="0">
                                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsEditable}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding DisplayName}" Command="{Binding EditCommand}" ToolTip="{Binding EditHint}"
                                                        Padding="9,5" FontSize="12" Margin="0" BorderThickness="0" />
                                                <Button Content="×" Command="{Binding RemoveCommand}" ToolTip="{loc:Tr RemoveTitle}"
                                                        AutomationProperties.Name="{loc:Tr RemoveTitle}" Padding="7,5" FontSize="12" Margin="0" BorderThickness="0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource FieldBackground}" CornerRadius="0" Padding="8,5" MaxWidth="340">
                                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsEditable}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="10" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{loc:Tr AddBinding}" Command="{Binding AddCommand}" VerticalAlignment="Center" Padding="8,5" FontSize="11" Margin="8,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Description}"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="12,4,0,8" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ActionNamePanel" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ActionNamePanel" Property="Background" Value="{StaticResource Accent}" />
                    <Setter TargetName="ActionName" Property="Foreground" Value="{StaticResource SelectionInk}" />
                    <Setter TargetName="ActionCode" Property="Foreground" Value="{StaticResource SelectionInk}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="MainRoot" Margin="24,18" Background="{StaticResource MenuBackdrop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="HeaderGrid" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition x:Name="QuoteColumn" Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderPath" Text="{loc:Tr UI.MenuPath}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                <TextBlock x:Name="HeaderTitle" Text="{loc:Tr UI.ControlTitle}" ToolTip="{loc:Tr BuildLabel}" Foreground="{StaticResource Accent}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="HeaderSubtitle" Text="{loc:Tr AppSubtitle}" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="QuotePanel" Grid.Column="1" VerticalAlignment="Center" Margin="20,8,12,0">
                <TextBlock Text="{loc:Tr UI.PixyQuote}" Foreground="{StaticResource TextSecondary}" FontFamily="Georgia" FontSize="14" FontStyle="Italic" LineHeight="19" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="— Pixy" Foreground="{StaticResource TextSecondary}" FontFamily="Georgia" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel x:Name="LanguagePanel" Grid.Column="2" Width="210" Margin="18,0,0,0">
                <TextBlock x:Name="BuildText" Text="{loc:Tr BuildLabel}" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,8" />
                <TextBlock x:Name="LanguageLabel" Text="{loc:Tr Language.Label}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,3" />
                <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding Languages}" DisplayMemberPath="NativeName" SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" FontSize="12"
                          AutomationProperties.Name="{loc:Tr Language.Label}" ToolTip="{loc:Tr Language.Hint}" />
            </StackPanel>
        </Grid>
        <Border x:Name="ConfigPanel" Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel x:Name="ConfigHeader" Margin="0,0,0,5">
                    <TextBlock Text="{loc:Tr ConfigFile}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                    <TextBlock Text="{Binding DirtyLabel}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="FilePathBox" Text="{Binding FilePath, Mode=OneWay}" ToolTip="{Binding FilePath}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}" FontSize="13" Padding="0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <WrapPanel x:Name="Toolbar" Grid.Row="2" Margin="0,0,0,10">
            <Button x:Name="OpenFileButton" Content="{loc:Tr OpenFile}" Command="{Binding OpenCommand}" Margin="0,0,8,6" />
            <Button x:Name="SaveFileButton" Content="{loc:Tr Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" />
            <WrapPanel x:Name="SecondaryActions">
                <Button Content="{loc:Tr Discard}" Command="{Binding DiscardCommand}" Margin="0,0,8,6" />
                <Button Content="{loc:Tr Reload}" Command="{Binding ReloadCommand}" Margin="0,0,8,6" />
                <Button Content="{loc:Tr Restore}" Command="{Binding RestoreCommand}" Margin="0,0,0,6" />
            </WrapPanel>
            <Button x:Name="MoreActionsButton" Content="⋯" ToolTip="{loc:Tr UI.MoreActions}" AutomationProperties.Name="{loc:Tr UI.MoreActions}" Click="OpenMoreActions" Margin="0,0,0,6" Visibility="Collapsed">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Tr Discard}" Command="{Binding DiscardCommand}" />
                        <MenuItem Header="{loc:Tr Reload}" Command="{Binding ReloadCommand}" />
                        <MenuItem Header="{loc:Tr Restore}" Command="{Binding RestoreCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>
        <TabControl Grid.Row="3" ItemsSource="{Binding Sections}" SelectedIndex="0">
            <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /></DataTemplate></TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="12,12,12,10" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Margin" Value="8,6,8,6" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel>
                            <Border Background="{StaticResource FieldBackground}" BorderBrush="{StaticResource QuietFrameBrush}" BorderThickness="1">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,0,0,8" /><Style.Triggers><DataTrigger Binding="{Binding ShowMouseOption}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0,0,0,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <CheckBox Content="{loc:Tr MouseFlight.Use}" IsChecked="{Binding UseMouseInFlight, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggleMouse}" ToolTip="{Binding MouseHelp}" ToolTipService.ShowOnDisabled="True"
                                          AutomationProperties.Name="{loc:Tr MouseFlight.Use}" />
                            </Border>
                            <TextBlock Text="{Binding ShortNote}" ToolTip="{Binding Note}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,0,0,6">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Problem}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConflictText}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ConflictText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchBox" Tag="ActionSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Tr Search.Label}" ToolTip="{loc:Tr Search.Hint}"
                                         Background="{StaticResource PanelBackground}" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource FrameBrush}" Padding="10,8" FontSize="13" TextChanged="OnFilterChanged" />
                                <TextBlock Text="{loc:Tr Search.Placeholder}" Foreground="{StaticResource TextSecondary}" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Content="{loc:Tr Search.Clear}" Command="{Binding ClearSearchCommand}" Padding="10,6" Margin="6,0,10,0" FontSize="12" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding GroupOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedGroupId, Mode=TwoWay}" SelectionChanged="OnFilterChanged"
                                      AutomationProperties.Name="{loc:Tr Group.Label}" ToolTip="{loc:Tr Group.Label}" Foreground="{StaticResource TextPrimary}" Padding="8,6" FontSize="13" />
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="0,0,0,6">
                            <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                            <TextBlock Text="{loc:Tr Binding.EditHint}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                        </DockPanel>
                        <Grid Grid.Row="3">
                            <ScrollViewer Tag="ActionList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <DockPanel Margin="0,6,0,7" Background="#604B230D">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold" Margin="10,6" />
                                                    <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="10,6" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="10,0,0,8">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionRowTemplate}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border VerticalAlignment="Top" Background="{StaticResource PanelBackground}" CornerRadius="0" Padding="12,8" Margin="0,6,10,0">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasNoResults}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Tr Search.NoResults}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Tr Search.TryAgain}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Tr Search.Reset}" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Center" Padding="10,6" FontSize="12" Margin="0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <StackPanel x:Name="FooterPanel" Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock x:Name="FooterNote" Text="{loc:Tr Footer}"
                       Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</Window>

